// Public Worker. Top level = local dev; env.staging and env.production are deployed by CI.
// Bindings (d1_databases, r2_buckets) and vars are NOT inherited by environments:
// when you add one, add it to the top level AND to both env.staging and env.production.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byd-manuals-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "workers_dev": true,
  // Preview URLs would share the real database (architecture.md §8).
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "byd-manuals-dev",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MANUALS", "bucket_name": "byd-manuals-dev" }],
  "vars": {
    "ENVIRONMENT": "development",
    "TELEBIRR_PHONE": "0900000000",
    "TELEBIRR_NAME": "Test Account",
    "SUPPORT_CONTACT": "info@mekinatera.com",
    "CLAIM_WINDOW_DAYS": "7",
    "TOKEN_TTL_HOURS": "24",
    "TOKEN_MAX_DOWNLOADS": "3",
    "POLL_TIMEOUT_MINUTES": "10",
    // Turnstile test site key (always passes); production uses the real one.
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "RATE_LIMIT_MAX": "10",
    "RATE_LIMIT_WINDOW_MINUTES": "10"
  },
  "env": {
    "staging": {
      "name": "byd-manuals-staging",
      // Not inherited from the top level: keep in sync with it and with production.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "byd-manuals-staging",
          "database_id": "f93aaa5c-11b8-4bf5-9741-6a0870468d4d",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MANUALS", "bucket_name": "byd-manuals-staging" }],
      "vars": {
        "ENVIRONMENT": "staging",
        "TELEBIRR_PHONE": "0900000000",
        "TELEBIRR_NAME": "Test Account",
        "SUPPORT_CONTACT": "yegnatop10@gmail.com",
        "CLAIM_WINDOW_DAYS": "7",
        "TOKEN_TTL_HOURS": "24",
        "TOKEN_MAX_DOWNLOADS": "3",
        "POLL_TIMEOUT_MINUTES": "10",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFs4S3aT1iWpg06u",
        "RATE_LIMIT_MAX": "10",
        "RATE_LIMIT_WINDOW_MINUTES": "10"
      }
    },
    "production": {
      "name": "byd-manuals",
      // Not inherited from the top level: keep in sync with it and with staging.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "byd-manuals",
          "database_id": "a9ceb33b-7036-4618-850f-37ce4068e6cc",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "MANUALS", "bucket_name": "byd-manuals" }],
      "vars": {
        "ENVIRONMENT": "production",
        "TELEBIRR_PHONE": "0977328406",
        "TELEBIRR_NAME": "Dawit As****",
        "SUPPORT_CONTACT": "yegnatop10@gmail.com",
        "CLAIM_WINDOW_DAYS": "7",
        "TOKEN_TTL_HOURS": "24",
        "TOKEN_MAX_DOWNLOADS": "3",
        "POLL_TIMEOUT_MINUTES": "10",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFs4S3aT1iWpg06u",
        "RATE_LIMIT_MAX": "10",
        "RATE_LIMIT_WINDOW_MINUTES": "10"
      }
    }
  }
}
